# ============================================================
# Secrets / 자격증명 — 절대 커밋 금지
# (주의: .gitignore 는 인라인 주석 미지원 → 주석은 반드시 별도 줄)
# ============================================================
# .env: 토스 라이브 키 (TOSS_CLIENT_ID/SECRET)
.env
.env.*
!.env.example
# .mcp.json: MCP 설정 — GitHub PAT 등 토큰 포함
.mcp.json
*.pem
*.key
*.p12
secrets.*
credentials.*
*_secret*
*token*.json

# ============================================================
# 운영 산출물 — 계좌/포지션/주문/시세 데이터 포함 가능
# ============================================================
status.json
status_*.json
logs/
logs_*/
reports/
data/
*.sqlite
*.sqlite3
*.db

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================
# 도구 / 에디터 / OS 상태
# ============================================================
.claude/
.omc/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
