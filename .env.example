# Toss Securities Open API — 템플릿. 복사해서 .env 로 쓰고 실제 키를 채우세요.
TOSS_CLIENT_ID=your_client_id_here
TOSS_CLIENT_SECRET=your_client_secret_here
TOSS_API_BASE=https://openapi.tossinvest.com

# Read-only premarket evidence providers. Values are never written to artifacts.
MARKETAUX_API_TOKEN=
# Example: AI Trading Research your-email@example.com
SEC_EDGAR_USER_AGENT=
FRED_API_KEY=
